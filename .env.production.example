# Copy to .env.production, replace every secret, and never commit that file.
GOPI_API_KEY=replace-with-at-least-32-random-characters
GOPI_DEVICE=cpu
GOPI_CHECKPOINT_DIR=./checkpoints/v2-dpo
GOPI_ALLOWED_HOSTS=localhost,127.0.0.1,gopi.local,api
GOPI_CORS_ORIGINS=https://localhost:8443
GOPI_DOCS_ENABLED=false
GOPI_MAX_CONCURRENCY=1
GOPI_REQUESTS_PER_MINUTE=30
GOPI_HTTPS_PORT=8443
