# ==========================================
# LLM Engine Environment Configuration (.env)
# ==========================================

# Device Selection: 'cuda' (GPU), 'cpu', or 'auto' (automatic detection)
GOPI_DEVICE=auto

# Model & Model Config Paths
GOPI_MODEL_CONFIG=configs/model.gpu.yaml
GOPI_INFERENCE_CONFIG=configs/inference.yaml
GOPI_TOKENIZER_PATH=data/tokenizer-v3
GOPI_CHECKPOINT_PATH=checkpoints/finetuning/best.pt
GOPI_SESSION_STORE=data/cache/sessions.sqlite

# Serving / API Server Settings
GOPI_MODEL_NAME=gopi
GOPI_BOT_NAME=Gopi
GOPI_MAX_CONCURRENCY=1
GOPI_QUEUE_TIMEOUT_SECONDS=5.0
GOPI_GENERATION_TIMEOUT_SECONDS=180.0
GOPI_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
GOPI_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
GOPI_REQUESTS_PER_MINUTE=60
GOPI_DOCS_ENABLED=true
GOPI_PROTECT_METRICS=false
# Trust only the address of your reverse proxy. '*' is safe only on an isolated container network.
GOPI_FORWARDED_ALLOW_IPS=127.0.0.1
# Interactive chat output: plain or markdown
GOPI_RESPONSE_FORMAT=plain
# GOPI_API_KEY=your_secret_api_key_here
# Free web search (defaults shown; point the URL at your SearXNG instance)
GOPI_SEARCH_PROVIDER=searxng
GOPI_SEARXNG_URL=http://localhost:8080/search
# Optional Brave fallback: set provider=brave and provide its API key
GOPI_SEARCH_API_KEY=your_brave_search_api_key_here

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
