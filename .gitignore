# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build and packaging output
build/
dist/
*.egg-info/

# IDE and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Local environment and secrets
.env
.env.*
!.env.example
!.env.production.example
deploy/certs/

# Datasets and generated caches
data/raw/*
data/processed/*
data/cache/*
data/rag/*
data/shards/*
data/tokenizer/*
data/tokenizer-*/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/*/
data/processed/*/*
!data/processed/*/README.md
!data/processed/*/dataset-manifest.yaml
!data/cache/.gitkeep
!data/rag/.gitkeep
!data/rag/wikipedia/
data/rag/wikipedia/*
!data/rag/wikipedia/dataset-manifest.yaml
!data/shards/.gitkeep
!data/tokenizer/.gitkeep

# Training checkpoints and generated model exports
checkpoints/*
exports/gguf/*
exports/onnx/*
exports/safetensors/*
exports/torch_export/*
!checkpoints/.gitkeep
!exports/gguf/.gitkeep
!exports/onnx/.gitkeep
!exports/safetensors/.gitkeep
!exports/torch_export/.gitkeep

# Logs and local experiment tracking
*.log
runs/
wandb/
mlruns/

# Generated live-training reports and graph artifacts
reports/*
!reports/training_report.html
artifacts/

# Model and tensor artifacts
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.gguf
*.npz
*.pt2
*.distcp
.metadata

# Local runtime databases and profiling output
*.sqlite
*.sqlite-shm
*.sqlite-wal
events.out.tfevents.*
*.trace.json

# Notebook scratch state
.ipynb_checkpoints/
